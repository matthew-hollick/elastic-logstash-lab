{
  "description": "Read-only access to shared data products (*-share indices) and the 'share' Kibana space only",
  "cluster": [],
  "indices": [
    {
      "names": ["*-share"],
      "privileges": ["read", "view_index_metadata"]
    }
  ],
  "applications": [
    {
      "application": "kibana-.kibana",
      "privileges": [
        "feature_discover.read",
        "feature_dashboard.read",
        "feature_indexPatterns.read"
      ],
      "resources": ["space:share"]
    }
  ]
}
