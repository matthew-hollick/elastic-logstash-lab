{
  "description": "Syslog Router routing rules for Cisco ASA/FTD/IOS events. Installed as logs-syslog_router.log@custom so the syslog_router integration ingest pipeline reroutes matched events to the correct integration data stream.",
  "processors": [
    {
      "set": {
        "tag": "route_cisco_asa",
        "field": "_conf.dataset",
        "value": "cisco_asa.log",
        "if": "ctx.message =~ /%ASA-/"
      }
    },
    {
      "set": {
        "tag": "route_cisco_ftd",
        "field": "_conf.dataset",
        "value": "cisco_ftd.log",
        "if": "ctx._conf?.dataset == null && ctx.message =~ /%FTD-/"
      }
    },
    {
      "set": {
        "tag": "route_cisco_ios",
        "field": "_conf.dataset",
        "value": "cisco_ios.log",
        "if": "ctx._conf?.dataset == null && ctx.message =~ /%[A-Za-z]+-[0-9]-[^ :]+:/"
      }
    },
    {
      "set": {
        "tag": "set_tz_offset",
        "field": "_conf.tz_offset",
        "value": "UTC",
        "if": "ctx._conf?.dataset != null && (ctx._conf.dataset == 'cisco_asa.log' || ctx._conf.dataset == 'cisco_ftd.log' || ctx._conf.dataset == 'cisco_ios.log')"
      }
    },
    {
      "set": {
        "tag": "set_internal_zones_asa_ftd",
        "field": "_temp_.internal_zones",
        "value": ["trust"],
        "if": "ctx._conf?.dataset == 'cisco_asa.log' || ctx._conf?.dataset == 'cisco_ftd.log'"
      }
    },
    {
      "set": {
        "tag": "set_external_zones_asa_ftd",
        "field": "_temp_.external_zones",
        "value": ["untrust"],
        "if": "ctx._conf?.dataset == 'cisco_asa.log' || ctx._conf?.dataset == 'cisco_ftd.log'"
      }
    }
  ],
  "on_failure": [
    {
      "append": {
        "field": "error.message",
        "value": "Processor '{{{ _ingest.on_failure_processor_type }}}' with tag '{{{ _ingest.on_failure_processor_tag }}}' failed with message '{{{ _ingest.on_failure_message }}}'"
      }
    },
    {
      "set": {
        "field": "event.kind",
        "value": "pipeline_error"
      }
    }
  ]
}
